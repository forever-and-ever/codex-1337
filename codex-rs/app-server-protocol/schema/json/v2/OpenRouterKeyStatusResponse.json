{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "AbsolutePathBuf": {
      "description": "A path that is guaranteed to be absolute and normalized (though it is not guaranteed to be canonicalized or exist on the filesystem).\n\nIMPORTANT: When deserializing an `AbsolutePathBuf`, a base path must be set using [AbsolutePathBufGuard::new]. If no base path is set, the deserialization will fail unless the path being deserialized is already absolute.",
      "type": "string"
    },
    "KeyName": {
      "description": "The name of an `OpenRouter` key; config maps it to the file holding the secret.",
      "type": "string"
    },
    "OpenRouterKey": {
      "properties": {
        "isDefault": {
          "type": "boolean"
        },
        "name": {
          "$ref": "#/definitions/KeyName"
        },
        "path": {
          "$ref": "#/definitions/AbsolutePathBuf"
        }
      },
      "required": [
        "isDefault",
        "name",
        "path"
      ],
      "type": "object"
    },
    "OpenRouterKeyLimit": {
      "properties": {
        "limit": {
          "$ref": "#/definitions/Usd"
        },
        "remaining": {
          "$ref": "#/definitions/Usd"
        },
        "reset": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "limit",
        "remaining"
      ],
      "type": "object"
    },
    "OpenRouterKeyState": {
      "oneOf": [
        {
          "properties": {
            "balance": {
              "anyOf": [
                {
                  "$ref": "#/definitions/Usd"
                },
                {
                  "type": "null"
                }
              ]
            },
            "capturedAt": {
              "format": "int64",
              "type": "integer"
            },
            "expiresAt": {
              "format": "int64",
              "type": [
                "integer",
                "null"
              ]
            },
            "label": {
              "type": "string"
            },
            "limit": {
              "anyOf": [
                {
                  "$ref": "#/definitions/OpenRouterKeyLimit"
                },
                {
                  "type": "null"
                }
              ]
            },
            "spend": {
              "$ref": "#/definitions/OpenRouterSpend"
            },
            "type": {
              "enum": [
                "read"
              ],
              "title": "ReadOpenRouterKeyStateType",
              "type": "string"
            }
          },
          "required": [
            "capturedAt",
            "label",
            "spend",
            "type"
          ],
          "title": "ReadOpenRouterKeyState",
          "type": "object"
        },
        {
          "properties": {
            "error": {
              "type": "string"
            },
            "type": {
              "enum": [
                "failed"
              ],
              "title": "FailedOpenRouterKeyStateType",
              "type": "string"
            }
          },
          "required": [
            "error",
            "type"
          ],
          "title": "FailedOpenRouterKeyState",
          "type": "object"
        }
      ]
    },
    "OpenRouterKeyStatus": {
      "properties": {
        "key": {
          "$ref": "#/definitions/OpenRouterKey"
        },
        "outstandingBatches": {
          "default": 0,
          "description": "Locally admitted jobs whose invoice is not yet known, including ambiguous submissions.",
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "state": {
          "$ref": "#/definitions/OpenRouterKeyState"
        }
      },
      "required": [
        "key",
        "state"
      ],
      "type": "object"
    },
    "OpenRouterSpend": {
      "properties": {
        "daily": {
          "$ref": "#/definitions/Usd"
        },
        "monthly": {
          "$ref": "#/definitions/Usd"
        },
        "weekly": {
          "$ref": "#/definitions/Usd"
        }
      },
      "required": [
        "daily",
        "monthly",
        "weekly"
      ],
      "type": "object"
    },
    "Usd": {
      "format": "double",
      "type": "number"
    }
  },
  "properties": {
    "keys": {
      "items": {
        "$ref": "#/definitions/OpenRouterKeyStatus"
      },
      "type": "array"
    }
  },
  "required": [
    "keys"
  ],
  "title": "OpenRouterKeyStatusResponse",
  "type": "object"
}