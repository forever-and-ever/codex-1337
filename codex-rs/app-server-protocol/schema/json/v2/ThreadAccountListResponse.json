{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "AbsolutePathBuf": {
      "description": "A path that is guaranteed to be absolute and normalized (though it is not guaranteed to be canonicalized or exist on the filesystem).\n\nIMPORTANT: When deserializing an `AbsolutePathBuf`, a base path must be set using [AbsolutePathBufGuard::new]. If no base path is set, the deserialization will fail unless the path being deserialized is already absolute.",
      "type": "string"
    },
    "AccountProvider": {
      "enum": [
        "openai",
        "claudeSubscription",
        "openrouter"
      ],
      "type": "string"
    },
    "ClaudeSubscriptionAccount": {
      "properties": {
        "available": {
          "description": "Whether this saved identity can be selected; not an upstream availability check.",
          "type": "boolean"
        },
        "email": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "description": "Stable upstream subscription identity; never a bearer token.",
          "type": "string"
        },
        "nickname": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "available",
        "id"
      ],
      "type": "object"
    },
    "KeyName": {
      "description": "The name of an `OpenRouter` key; config maps it to the file holding the secret.",
      "type": "string"
    },
    "OpenRouterKey": {
      "properties": {
        "isDefault": {
          "type": "boolean"
        },
        "name": {
          "$ref": "#/definitions/KeyName"
        },
        "path": {
          "$ref": "#/definitions/AbsolutePathBuf"
        }
      },
      "required": [
        "isDefault",
        "name",
        "path"
      ],
      "type": "object"
    },
    "OpenRouterKeyLimit": {
      "properties": {
        "limit": {
          "$ref": "#/definitions/Usd"
        },
        "remaining": {
          "$ref": "#/definitions/Usd"
        },
        "reset": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "limit",
        "remaining"
      ],
      "type": "object"
    },
    "OpenRouterKeyState": {
      "oneOf": [
        {
          "properties": {
            "balance": {
              "anyOf": [
                {
                  "$ref": "#/definitions/Usd"
                },
                {
                  "type": "null"
                }
              ]
            },
            "capturedAt": {
              "format": "int64",
              "type": "integer"
            },
            "expiresAt": {
              "format": "int64",
              "type": [
                "integer",
                "null"
              ]
            },
            "label": {
              "type": "string"
            },
            "limit": {
              "anyOf": [
                {
                  "$ref": "#/definitions/OpenRouterKeyLimit"
                },
                {
                  "type": "null"
                }
              ]
            },
            "spend": {
              "$ref": "#/definitions/OpenRouterSpend"
            },
            "type": {
              "enum": [
                "read"
              ],
              "title": "ReadOpenRouterKeyStateType",
              "type": "string"
            }
          },
          "required": [
            "capturedAt",
            "label",
            "spend",
            "type"
          ],
          "title": "ReadOpenRouterKeyState",
          "type": "object"
        },
        {
          "properties": {
            "error": {
              "type": "string"
            },
            "type": {
              "enum": [
                "failed"
              ],
              "title": "FailedOpenRouterKeyStateType",
              "type": "string"
            }
          },
          "required": [
            "error",
            "type"
          ],
          "title": "FailedOpenRouterKeyState",
          "type": "object"
        }
      ]
    },
    "OpenRouterKeyStatus": {
      "properties": {
        "key": {
          "$ref": "#/definitions/OpenRouterKey"
        },
        "outstandingBatches": {
          "default": 0,
          "description": "Locally admitted jobs whose invoice is not yet known, including ambiguous submissions.",
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "state": {
          "$ref": "#/definitions/OpenRouterKeyState"
        }
      },
      "required": [
        "key",
        "state"
      ],
      "type": "object"
    },
    "OpenRouterSpend": {
      "properties": {
        "daily": {
          "$ref": "#/definitions/Usd"
        },
        "monthly": {
          "$ref": "#/definitions/Usd"
        },
        "weekly": {
          "$ref": "#/definitions/Usd"
        }
      },
      "required": [
        "daily",
        "monthly",
        "weekly"
      ],
      "type": "object"
    },
    "SavedAccount": {
      "properties": {
        "alias": {
          "type": [
            "string",
            "null"
          ]
        },
        "email": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "nickname": {
          "type": [
            "string",
            "null"
          ]
        },
        "plan": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "Usd": {
      "format": "double",
      "type": "number"
    }
  },
  "properties": {
    "accounts": {
      "items": {
        "$ref": "#/definitions/SavedAccount"
      },
      "type": "array"
    },
    "claudeAccounts": {
      "items": {
        "$ref": "#/definitions/ClaudeSubscriptionAccount"
      },
      "type": "array"
    },
    "claudeManagementError": {
      "type": [
        "string",
        "null"
      ]
    },
    "conversationProvider": {
      "anyOf": [
        {
          "$ref": "#/definitions/AccountProvider"
        },
        {
          "type": "null"
        }
      ]
    },
    "openrouterKeys": {
      "items": {
        "$ref": "#/definitions/OpenRouterKeyStatus"
      },
      "type": "array"
    },
    "pendingAccountId": {
      "description": "Selected target whose handoff is not yet complete.",
      "type": [
        "string",
        "null"
      ]
    },
    "pendingClaudeAccountId": {
      "type": [
        "string",
        "null"
      ]
    },
    "pendingOpenrouterKey": {
      "anyOf": [
        {
          "$ref": "#/definitions/KeyName"
        },
        {
          "type": "null"
        }
      ]
    },
    "selectedAccountId": {
      "type": [
        "string",
        "null"
      ]
    },
    "selectedClaudeAccountId": {
      "type": [
        "string",
        "null"
      ]
    },
    "selectedOpenrouterKey": {
      "anyOf": [
        {
          "$ref": "#/definitions/KeyName"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "accounts",
    "claudeAccounts",
    "openrouterKeys"
  ],
  "title": "ThreadAccountListResponse",
  "type": "object"
}