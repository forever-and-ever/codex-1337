{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "LegacyAppPathString": {
      "type": "string"
    },
    "NewThreadAccountParams": {
      "properties": {
        "config": {
          "additionalProperties": true,
          "description": "Configuration overrides, as in `thread/start`.",
          "type": [
            "object",
            "null"
          ]
        },
        "cwd": {
          "anyOf": [
            {
              "$ref": "#/definitions/LegacyAppPathString"
            },
            {
              "type": "null"
            }
          ],
          "description": "Absolute working directory used to resolve the new conversation's configuration."
        },
        "modelProvider": {
          "description": "Provider override, as in `thread/start`; omission uses the server default.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "ResetCreditConfirmation": {
      "properties": {
        "scope": {
          "$ref": "#/definitions/ResetCreditScope"
        },
        "token": {
          "description": "Opaque server-issued binding to the payer observed during this usage read.",
          "type": "string"
        }
      },
      "required": [
        "scope",
        "token"
      ],
      "type": "object"
    },
    "ResetCreditScope": {
      "oneOf": [
        {
          "properties": {
            "type": {
              "enum": [
                "global"
              ],
              "title": "GlobalResetCreditScopeType",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "title": "GlobalResetCreditScope",
          "type": "object"
        },
        {
          "properties": {
            "thread_id": {
              "type": "string"
            },
            "type": {
              "enum": [
                "thread"
              ],
              "title": "ThreadResetCreditScopeType",
              "type": "string"
            }
          },
          "required": [
            "thread_id",
            "type"
          ],
          "title": "ThreadResetCreditScope",
          "type": "object"
        },
        {
          "properties": {
            "params": {
              "$ref": "#/definitions/NewThreadAccountParams"
            },
            "type": {
              "enum": [
                "newThread"
              ],
              "title": "NewThreadResetCreditScopeType",
              "type": "string"
            }
          },
          "required": [
            "params",
            "type"
          ],
          "title": "NewThreadResetCreditScope",
          "type": "object"
        }
      ]
    }
  },
  "properties": {
    "confirmation": {
      "anyOf": [
        {
          "$ref": "#/definitions/ResetCreditConfirmation"
        },
        {
          "type": "null"
        }
      ],
      "description": "Reuse the usage read's binding for confirmation and every retry."
    },
    "creditId": {
      "description": "Opaque reset-credit identifier to redeem. When omitted, the backend selects the next available credit.",
      "type": [
        "string",
        "null"
      ]
    },
    "idempotencyKey": {
      "description": "Identifies one logical reset attempt. A UUID is recommended; reuse the same value when retrying that attempt.",
      "type": "string"
    },
    "newThread": {
      "anyOf": [
        {
          "$ref": "#/definitions/NewThreadAccountParams"
        },
        {
          "type": "null"
        }
      ],
      "description": "Spend a fresh root conversation's reset credit instead of the global login's. Cannot be combined with `threadId`."
    },
    "threadId": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "idempotencyKey"
  ],
  "title": "ConsumeAccountRateLimitResetCreditParams",
  "type": "object"
}