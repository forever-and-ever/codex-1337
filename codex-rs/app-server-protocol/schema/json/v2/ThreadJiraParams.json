{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "JiraAction": {
      "oneOf": [
        {
          "properties": {
            "cursor": {
              "type": [
                "string",
                "null"
              ]
            },
            "limit": {
              "format": "uint32",
              "minimum": 0.0,
              "type": [
                "integer",
                "null"
              ]
            },
            "recursive": {
              "description": "Include stored descendant projects. Older clients retain exact-project lists.",
              "type": "boolean"
            },
            "type": {
              "enum": [
                "list"
              ],
              "title": "ListJiraActionType",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "title": "ListJiraAction",
          "type": "object"
        },
        {
          "properties": {
            "key": {
              "$ref": "#/definitions/JiraKey"
            },
            "type": {
              "enum": [
                "read"
              ],
              "title": "ReadJiraActionType",
              "type": "string"
            }
          },
          "required": [
            "key",
            "type"
          ],
          "title": "ReadJiraAction",
          "type": "object"
        },
        {
          "properties": {
            "body": {
              "type": "string"
            },
            "key": {
              "$ref": "#/definitions/JiraKey"
            },
            "previous": {
              "anyOf": [
                {
                  "$ref": "#/definitions/JiraRevision"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Omitted for creation. For edits, includes the fetched version and immutable epic."
            },
            "type": {
              "enum": [
                "save"
              ],
              "title": "SaveJiraActionType",
              "type": "string"
            }
          },
          "required": [
            "body",
            "key",
            "type"
          ],
          "title": "SaveJiraAction",
          "type": "object"
        },
        {
          "properties": {
            "revision": {
              "$ref": "#/definitions/JiraRevision"
            },
            "type": {
              "enum": [
                "delete"
              ],
              "title": "DeleteJiraActionType",
              "type": "string"
            }
          },
          "required": [
            "revision",
            "type"
          ],
          "title": "DeleteJiraAction",
          "type": "object"
        }
      ]
    },
    "JiraCategory": {
      "enum": [
        "bug",
        "feature"
      ],
      "type": "string"
    },
    "JiraKey": {
      "properties": {
        "category": {
          "$ref": "#/definitions/JiraCategory"
        },
        "project": {
          "anyOf": [
            {
              "$ref": "#/definitions/LegacyAppPathString"
            },
            {
              "type": "null"
            }
          ],
          "description": "Absolute stored project namespace; null selects the browsing cwd's default project."
        },
        "slug": {
          "type": "string"
        }
      },
      "required": [
        "category",
        "slug"
      ],
      "type": "object"
    },
    "JiraRevision": {
      "properties": {
        "epic": {
          "type": [
            "string",
            "null"
          ]
        },
        "key": {
          "$ref": "#/definitions/JiraKey"
        },
        "version": {
          "description": "SHA-256 of the exact stored UTF-8 bytes; optimistic external-edit guard.",
          "type": "string"
        }
      },
      "required": [
        "key",
        "version"
      ],
      "type": "object"
    },
    "LegacyAppPathString": {
      "type": "string"
    }
  },
  "description": "Server-local issue storage scoped by the persisted conversation cwd.",
  "properties": {
    "action": {
      "$ref": "#/definitions/JiraAction"
    },
    "expectedScope": {
      "description": "Scope returned by the initial list. Required for all reads and mutations.",
      "type": [
        "string",
        "null"
      ]
    },
    "threadId": {
      "type": "string"
    }
  },
  "required": [
    "action",
    "threadId"
  ],
  "title": "ThreadJiraParams",
  "type": "object"
}