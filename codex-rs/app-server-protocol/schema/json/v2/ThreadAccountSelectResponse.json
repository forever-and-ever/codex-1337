{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "AccountProvider": {
      "enum": [
        "openai",
        "claudeSubscription",
        "openrouter"
      ],
      "type": "string"
    }
  },
  "properties": {
    "accountId": {
      "type": "string"
    },
    "conversationChanged": {
      "description": "False when choosing the other provider's new-conversation default.",
      "type": "boolean"
    },
    "defaultSaved": {
      "description": "False means saving the new-thread default failed; the selection was still accepted.",
      "type": "boolean"
    },
    "pending": {
      "default": false,
      "description": "Whether this thread's account handoff is still pending.",
      "type": "boolean"
    },
    "provider": {
      "$ref": "#/definitions/AccountProvider"
    }
  },
  "required": [
    "accountId",
    "conversationChanged",
    "defaultSaved",
    "provider"
  ],
  "title": "ThreadAccountSelectResponse",
  "type": "object"
}