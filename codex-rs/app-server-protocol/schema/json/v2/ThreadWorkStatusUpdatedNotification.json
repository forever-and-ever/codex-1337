{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "WorkStatus": {
      "description": "A complete live status snapshot. Activity belongs to the named task.",
      "properties": {
        "activity": {
          "type": [
            "string",
            "null"
          ]
        },
        "task": {
          "type": "string"
        },
        "turnId": {
          "type": "string"
        }
      },
      "required": [
        "task",
        "turnId"
      ],
      "type": "object"
    }
  },
  "description": "Live presentation metadata, excluded from thread history and resume snapshots.",
  "properties": {
    "status": {
      "$ref": "#/definitions/WorkStatus"
    },
    "threadId": {
      "type": "string"
    }
  },
  "required": [
    "status",
    "threadId"
  ],
  "title": "ThreadWorkStatusUpdatedNotification",
  "type": "object"
}