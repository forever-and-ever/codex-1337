{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "WorkStatus": {
      "description": "What the agent is currently working on, scoped to one live turn.",
      "properties": {
        "activity": {
          "type": "string"
        },
        "turnId": {
          "type": "string"
        }
      },
      "required": [
        "activity",
        "turnId"
      ],
      "type": "object"
    }
  },
  "description": "Live presentation metadata, excluded from thread history and resume snapshots.",
  "properties": {
    "status": {
      "$ref": "#/definitions/WorkStatus"
    },
    "threadId": {
      "type": "string"
    }
  },
  "required": [
    "status",
    "threadId"
  ],
  "title": "ThreadWorkStatusUpdatedNotification",
  "type": "object"
}