{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ContextInventory": {
      "description": "Retained special material, including superseded instructions and their amendments. An inventory is not an arrival and is never inserted into model history.",
      "properties": {
        "parts": {
          "items": {
            "$ref": "#/definitions/PreamblePart"
          },
          "type": "array"
        },
        "raw": {
          "default": "",
          "description": "Legacy mixed capture; new records use typed sources.",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/definitions/ContextSource"
          },
          "type": "array"
        }
      },
      "required": [
        "parts"
      ],
      "type": "object"
    },
    "ContextSource": {
      "description": "Captured text and a client serialization of declarations are different evidence.",
      "oneOf": [
        {
          "properties": {
            "kind": {
              "enum": [
                "prompt"
              ],
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "label",
            "text"
          ],
          "type": "object"
        },
        {
          "description": "The declarations supplied to the provider, serialized by this client for inspection. This is not the provider's internal prompt serialization.",
          "properties": {
            "kind": {
              "enum": [
                "toolDeclarations"
              ],
              "type": "string"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "text"
          ],
          "type": "object"
        }
      ]
    },
    "PreamblePart": {
      "properties": {
        "group": {
          "description": "The MCP server or tool namespace a tool belongs to.",
          "type": [
            "string",
            "null"
          ]
        },
        "label": {
          "type": "string"
        },
        "section": {
          "$ref": "#/definitions/PreambleSection"
        },
        "tokens": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "label",
        "section",
        "tokens"
      ],
      "type": "object"
    },
    "PreambleSection": {
      "enum": [
        "instructions",
        "tools",
        "context"
      ],
      "type": "string"
    }
  },
  "properties": {
    "inventory": {
      "$ref": "#/definitions/ContextInventory"
    }
  },
  "required": [
    "inventory"
  ],
  "title": "ThreadContextInventoryResponse",
  "type": "object"
}