{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ContextInventory": {
      "description": "Retained special material, including superseded instructions and their amendments. An inventory is not an arrival and is never inserted into model history.",
      "properties": {
        "parts": {
          "items": {
            "$ref": "#/definitions/PreamblePart"
          },
          "type": "array"
        },
        "raw": {
          "type": "string"
        }
      },
      "required": [
        "parts",
        "raw"
      ],
      "type": "object"
    },
    "PreamblePart": {
      "properties": {
        "group": {
          "description": "The MCP server or tool namespace a tool belongs to.",
          "type": [
            "string",
            "null"
          ]
        },
        "label": {
          "type": "string"
        },
        "section": {
          "$ref": "#/definitions/PreambleSection"
        },
        "tokens": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "label",
        "section",
        "tokens"
      ],
      "type": "object"
    },
    "PreambleSection": {
      "enum": [
        "instructions",
        "tools",
        "context"
      ],
      "type": "string"
    }
  },
  "properties": {
    "inventory": {
      "$ref": "#/definitions/ContextInventory"
    }
  },
  "required": [
    "inventory"
  ],
  "title": "ThreadContextInventoryResponse",
  "type": "object"
}