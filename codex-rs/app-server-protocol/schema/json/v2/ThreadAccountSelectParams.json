{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "AccountProvider": {
      "enum": [
        "openai",
        "claudeSubscription",
        "openRouter"
      ],
      "type": "string"
    }
  },
  "properties": {
    "accountId": {
      "description": "Saved identity or an alias from `[wrangler.account_aliases]`.",
      "type": "string"
    },
    "provider": {
      "anyOf": [
        {
          "$ref": "#/definitions/AccountProvider"
        },
        {
          "type": "null"
        }
      ],
      "description": "Defaults to ChatGPT for pre-Claude clients; Claude selection must be explicit."
    },
    "threadId": {
      "type": "string"
    }
  },
  "required": [
    "accountId",
    "threadId"
  ],
  "title": "ThreadAccountSelectParams",
  "type": "object"
}