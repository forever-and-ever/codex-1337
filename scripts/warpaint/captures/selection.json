      {"text": "        ║                                                                                           ", "fg": "figure:ink_selected", "bg": "ground:selection", "mods": ["bold"]}
    ],
    [
      {"text": "        ║   • Lowered Op::Neg below multiplication in precedence()                                  ", "fg": "figure:ink_selected", "bg": "ground:selection", "mods": ["bold"]}
    ],
    [
      {"text": "        ║   • See ", "fg": "figure:ink_selected", "bg": "ground:selection", "mods": ["bold"]},
