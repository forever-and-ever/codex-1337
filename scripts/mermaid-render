#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# dependencies = ["pillow"]
# ///
"""Render a Mermaid diagram to PNG and SVG locally.

The fork's own renderer draws a deliberately small flowchart grammar in the terminal; this
is for diagrams that exceed it. Nothing leaves the machine: Mermaid's bundle is cached once
and the page is rendered by the local headless browser.

Optionally paints the diagram with a warpaint pack, so a diagram about the palette is drawn
in it.
"""

from __future__ import annotations

import argparse
import json
import re
import subprocess
import tempfile
import tomllib
import urllib.request
from pathlib import Path

from PIL import Image, ImageChops

BUNDLE = Path.home() / ".cache/mermaid/mermaid.min.js"
SOURCE = "https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.min.js"

PAGE = """<!doctype html>
<meta charset="utf-8">
<style>
  body {{ margin: 0; background: {canvas}; }}
  #d {{ padding: 28px; }}
  svg {{ max-width: none !important; height: auto; }}
</style>
<script>{bundle}</script>
<div id="d" class="mermaid">{diagram}</div>
<script>
  mermaid.initialize({{ startOnLoad: true, securityLevel: "loose", theme: "base",
                        flowchart: {{ htmlLabels: true, curve: "basis" }},
                        themeVariables: {theme} }});
</script>
"""


def theme_variables(pack: Path | None) -> tuple[dict[str, str], str]:
    if pack is None:
        return {"darkMode": "true"}, "#0d0f11"
    roles = tomllib.loads(pack.read_text())["roles"]
    return {
        "darkMode": "true",
        "background": roles["canvas"],
        "primaryColor": roles["dais"],
        "primaryTextColor": roles["ink"],
        "primaryBorderColor": roles["rule"],
        "secondaryColor": roles["trough"],
        "tertiaryColor": roles["trough"],
        "lineColor": roles["accent_muted"],
        "textColor": roles["ink_muted"],
        "clusterBkg": roles["trough"],
        "clusterBorder": roles["rule"],
        "edgeLabelBackground": roles["canvas"],
        "fontFamily": "JetBrains Mono, monospace",
        "fontSize": "15px",
    }, roles["canvas"]


def trim(image_path: Path, canvas: str) -> None:
    """A fixed window leaves the diagram adrift in empty canvas; keep only what was drawn."""
    image = Image.open(image_path).convert("RGB")
    field = Image.new("RGB", image.size, canvas)
    box = ImageChops.difference(image, field).getbbox()
    if box is None:
        return
    pad = 24
    image.crop(
        (
            max(0, box[0] - pad),
            max(0, box[1] - pad),
            min(image.width, box[2] + pad),
            min(image.height, box[3] + pad),
        )
    ).save(image_path)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("diagram", type=Path)
    parser.add_argument("--out", type=Path, help="PNG path; defaults beside the diagram")
    parser.add_argument("--pack", type=Path, help="warpaint pack to paint the diagram with")
    parser.add_argument("--width", type=int, default=1700)
    parser.add_argument("--height", type=int, default=1500)
    args = parser.parse_args()

    if not BUNDLE.exists():
        BUNDLE.parent.mkdir(parents=True, exist_ok=True)
        with urllib.request.urlopen(SOURCE, timeout=120) as response:
            BUNDLE.write_bytes(response.read())

    out = (args.out or args.diagram.with_suffix(".png")).resolve()
    out.parent.mkdir(parents=True, exist_ok=True)
    variables, canvas = theme_variables(args.pack)
    scratch = tempfile.TemporaryDirectory()
    page = Path(scratch.name) / "diagram.html"
    page.write_text(
        PAGE.format(
            bundle=BUNDLE.read_text(),
            diagram=args.diagram.read_text(),
            theme=json.dumps(variables),
            canvas=canvas,
        )
    )

    chrome = [
        "chromium",
        "--headless",
        "--no-sandbox",
        "--disable-gpu",
        "--hide-scrollbars",
        "--user-data-dir=/tmp/mermaid-render",
        "--virtual-time-budget=6000",
        f"--window-size={args.width},{args.height}",
    ]
    subprocess.run([*chrome, f"--screenshot={out}", page.as_uri()], check=True, capture_output=True)
    dom = subprocess.run([*chrome, "--dump-dom", page.as_uri()], check=True, capture_output=True, text=True).stdout
    # The page holds decorative glyphs as well; the diagram is the largest of them.
    drawings = re.findall(r"<svg\b.*?</svg>", dom, re.DOTALL)
    if drawings:
        out.with_suffix(".svg").write_text(max(drawings, key=len))
    trim(out, canvas)
    print(f"{out}\n{out.with_suffix('.svg')}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
