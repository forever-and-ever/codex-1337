#!/bin/sh
set -eu

die() {
    printf 'install-local refused: %s\n' "$1" >&2
    exit 1
}

root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
[ "$(uname -s)" = Linux ] || die 'this distribution is Linux-only'
case "${1:-}" in
    '') channel=current ;;
    --staging) channel=staging ;;
    *) die 'expected no arguments or --staging' ;;
esac
[ "$#" -le 1 ] || die 'expected no arguments or --staging'
if [ "$channel" = current ]; then
    [ -z "$(git -C "$root" status --porcelain)" ] || die 'source checkout is dirty'
fi

# rustup selects the workspace toolchain by cwd, not Cargo's --manifest-path.
cd "$root/codex-rs"

for command in bwrap cargo cut git install ld.lld ln mktemp mv python3 readlink rg rm rustc sed sha256sum uname zsh; do
    command -v "$command" >/dev/null 2>&1 || die "required command is absent: $command"
done

target=$(rustc --print host-tuple)
case "$target" in
    x86_64-unknown-linux-gnu | aarch64-unknown-linux-gnu) ;;
    *) die "unsupported host: $target" ;;
esac

install_root=${CODEX_INSTALL_ROOT:-$HOME/.local}
data_home=${XDG_DATA_HOME:-$HOME/.local/share}
case "$install_root:$data_home" in
    /*:/*) ;;
    *) die 'installation and XDG data roots must be absolute' ;;
esac

codex_version=$(sed -n \
    '/^\[workspace\.package\]$/,/^\[/s/^version = "\([^"]*\)"$/\1/p' \
    "$root/codex-rs/Cargo.toml")
[ -n "$codex_version" ] || die 'Codex workspace version is absent'

if [ -z "${CARGO_TARGET_DIR:-}" ]; then
    CARGO_TARGET_DIR=$(cargo metadata --format-version 1 --no-deps \
        --manifest-path "$root/codex-rs/Cargo.toml" \
        | sed -n 's/.*"target_directory":"\([^"]*\)".*/\1/p')
    [ -n "$CARGO_TARGET_DIR" ] || die 'Cargo target directory is absent'
    export CARGO_TARGET_DIR
fi
export CARGO_PROFILE_RELEASE_CODEGEN_UNITS=16
export CARGO_PROFILE_RELEASE_DEBUG=none
export CARGO_PROFILE_RELEASE_LTO=false
export CARGO_PROFILE_RELEASE_STRIP=symbols
if [ -z "${RUSTFLAGS:-}" ]; then
    RUSTFLAGS='-C target-cpu=native -C link-arg=-fuse-ld=lld'
    export RUSTFLAGS
fi

revision=$(git -C "$root" rev-parse HEAD)
short_revision=$(printf '%s' "$revision" | cut -c1-12)
identity="codex-$codex_version-1337-$short_revision"
distribution_root="$data_home/codex-1337/distributions"
payload="$distribution_root/$identity"
stage=
if [ "$channel" = staging ]; then
    [ -x "$distribution_root/current/bin/codex" ] \
        || die 'production distribution is absent'
fi

cleanup() {
    [ -z "$stage" ] || rm -rf -- "$stage"
}
trap cleanup EXIT HUP INT TERM

install -d -m755 "$distribution_root" "$install_root/bin" \
    "$install_root/share/zsh/site-functions"

if [ "$channel" = staging ] || [ ! -d "$payload" ]; then
    stage=$(mktemp -d "$distribution_root/.stage.XXXXXX")
    package="$stage/package"
    install -d -m755 "$package/bin" "$package/licenses"

    CODEX_REPO_ROOT="$root" PYTHONPATH="$root/scripts" \
    python3 - "$target" cargo build --locked --release \
        --manifest-path "$root/codex-rs/Cargo.toml" \
        --bin codex \
        --bin codex-code-mode-host \
        --bin codex-wrangler-bridge <<'PY'
import os
import sys

from codex_package.targets import TARGET_SPECS
from codex_package.v8 import resolve_codex_v8_cargo_env

environment = os.environ | resolve_codex_v8_cargo_env(
    TARGET_SPECS[sys.argv[1]]
)
os.execvpe(sys.argv[2], sys.argv[2:], environment)
PY

    for executable in codex codex-code-mode-host codex-wrangler-bridge; do
        install -Dm755 "$CARGO_TARGET_DIR/release/$executable" \
            "$package/bin/$executable"
    done
    install -Dm644 "$root/LICENSE" "$package/licenses/Codex-LICENSE"
    install -Dm644 "$root/NOTICE" "$package/licenses/Codex-NOTICE"
    "$package/bin/codex" completion zsh >"$package/_codex"
    if [ "$channel" = staging ]; then
        fingerprint=$(sha256sum "$package/bin/codex" \
            "$package/bin/codex-code-mode-host" \
            "$package/bin/codex-wrangler-bridge" \
            | cut -d ' ' -f 1 | sha256sum | cut -c 1-12)
        identity="codex-$codex_version-1337-$short_revision-stage-$fingerprint"
        payload="$distribution_root/$identity"
    fi
    printf 'codex_version=%s\nsource_commit=%s\n' \
        "$codex_version" "$revision" \
        >"$package/distribution"
    if [ ! -d "$payload" ]; then
        mv "$package" "$payload"
    fi
fi

for executable in codex codex-code-mode-host codex-wrangler-bridge; do
    [ -x "$payload/bin/$executable" ] || die "payload lacks $executable"
done
[ -f "$payload/distribution" ] || die 'payload provenance is absent'

previous=
if [ -L "$distribution_root/$channel" ]; then
    previous=$(readlink "$distribution_root/$channel")
fi
next="$distribution_root/.$channel.$$"
ln -s "$identity" "$next"
mv -Tf "$next" "$distribution_root/$channel"

if [ "$channel" = staging ]; then
    python3 "$root/scripts/local_integration.py" install-staging-launcher \
        "$distribution_root" "$install_root/bin/codex"
    python3 "$root/scripts/local_integration.py" install-staging \
        "$distribution_root/staging/bin/codex"
else
    python3 "$root/scripts/local_integration.py" install-launcher \
        "$distribution_root" "$install_root/bin/codex"
    for executable in codex-code-mode-host codex-wrangler-bridge; do
        next="$install_root/bin/.$executable.$$"
        ln -s "$distribution_root/current/bin/$executable" "$next"
        mv -Tf "$next" "$install_root/bin/$executable"
    done
    next="$install_root/share/zsh/site-functions/._codex.$$"
    ln -s "$distribution_root/current/_codex" "$next"
    mv -Tf "$next" "$install_root/share/zsh/site-functions/_codex"

    python3 "$root/scripts/local_integration.py" install "$install_root"
fi

# A live older TUI may still launch sibling helpers from its original bundle.
live_binaries=$(readlink /proc/[0-9]*/exe 2>/dev/null || true)
for candidate in "$distribution_root"/*; do
    [ -d "$candidate" ] || continue
    name=${candidate##*/}
    if [ "$channel" = staging ]; then
        case "$name" in *-stage-*) ;; *) continue ;; esac
    fi
    [ "$name" = current ] && continue
    [ "$name" = staging ] && continue
    [ "$name" = "$identity" ] && continue
    [ -n "$previous" ] && [ "$name" = "$previous" ] && continue
    if [ -L "$distribution_root/current" ] \
        && [ "$name" = "$(readlink "$distribution_root/current")" ]; then
        continue
    fi
    if [ -L "$distribution_root/staging" ] \
        && [ "$name" = "$(readlink "$distribution_root/staging")" ]; then
        continue
    fi
    [ -f "$candidate/distribution" ] || continue
    case "$live_binaries" in
        *"$candidate/bin/"*) continue ;;
    esac
    rm -rf -- "$candidate"
done

if [ "$channel" = staging ]; then
    printf 'installed staging Codex %s-1337 from %s\n' "$codex_version" "$short_revision"
else
    printf 'installed Codex %s-1337 from %s\n' "$codex_version" "$short_revision"
fi
