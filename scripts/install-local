#!/bin/sh
set -eu

die() {
    printf 'install-local refused: %s\n' "$1" >&2
    exit 1
}

root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
[ "$(uname -s)" = Linux ] || die 'this distribution is Linux-only'
[ -z "$(git -C "$root" status --porcelain)" ] || die 'source checkout is dirty'

for command in bwrap cargo cut git install ln mktemp mv python3 readlink rg rm rustc sed uname zsh; do
    command -v "$command" >/dev/null 2>&1 || die "required command is absent: $command"
done

target=$(rustc --print host-tuple)
case "$target" in
    x86_64-unknown-linux-gnu | aarch64-unknown-linux-gnu) ;;
    *) die "unsupported host: $target" ;;
esac

install_root=${CODEX_INSTALL_ROOT:-$HOME/.local}
data_home=${XDG_DATA_HOME:-$HOME/.local/share}
case "$install_root:$data_home" in
    /*:/*) ;;
    *) die 'installation and XDG data roots must be absolute' ;;
esac

codex_version=$(sed -n \
    '/^\[workspace\.package\]$/,/^\[/s/^version = "\([^"]*\)"$/\1/p' \
    "$root/codex-rs/Cargo.toml")
wrangler_version=$(sed -n \
    '/^\[workspace\.package\]$/,/^\[/s/^version = "\([^"]*\)"$/\1/p' \
    "$root/wrangler/Cargo.toml")
[ -n "$codex_version" ] || die 'Codex workspace version is absent'
[ -n "$wrangler_version" ] || die 'Wrangler workspace version is absent'

revision=$(git -C "$root" rev-parse HEAD)
short_revision=$(printf '%s' "$revision" | cut -c1-12)
identity="codex-$codex_version-wrangler-$wrangler_version-$short_revision"
distribution_root="$data_home/codex-wrangler/distributions"
payload="$distribution_root/$identity"
stage=

cleanup() {
    [ -z "$stage" ] || rm -rf -- "$stage"
}
trap cleanup EXIT HUP INT TERM

install -d -m755 "$distribution_root" "$install_root/bin" \
    "$install_root/share/zsh/site-functions"

if [ ! -d "$payload" ]; then
    stage=$(mktemp -d "$distribution_root/.stage.XXXXXX")
    package="$stage/package"

    CODEX_REPO_ROOT="$root" python3 "$root/scripts/build_codex_package.py" \
        --target "$target" \
        --package-version "$codex_version" \
        --cargo-profile release \
        --package-dir "$package" \
        --bwrap-bin "$(command -v bwrap)" \
        --rg-bin "$(command -v rg)" \
        --zsh-bin "$(command -v zsh)"

    cargo build --locked --release \
        --manifest-path "$root/codex-rs/Cargo.toml" \
        --bin codex-wrangler-bridge
    codex_target=$(cargo metadata --format-version 1 --no-deps \
        --manifest-path "$root/codex-rs/Cargo.toml" \
        | sed -n 's/.*"target_directory":"\([^"]*\)".*/\1/p')
    [ -n "$codex_target" ] || die 'Codex target directory is absent'

    cargo build --locked --release \
        --manifest-path "$root/wrangler/Cargo.toml" \
        --bin codex-wrangler
    wrangler_target=$(cargo metadata --format-version 1 --no-deps \
        --manifest-path "$root/wrangler/Cargo.toml" \
        | sed -n 's/.*"target_directory":"\([^"]*\)".*/\1/p')
    [ -n "$wrangler_target" ] || die 'Wrangler target directory is absent'

    install -Dm755 "$codex_target/release/codex-wrangler-bridge" \
        "$package/bin/codex-wrangler-bridge"
    install -Dm755 "$wrangler_target/release/codex-wrangler" \
        "$package/bin/codex-wrangler"
    install -Dm644 "$root/LICENSE" "$package/licenses/Codex-LICENSE"
    install -Dm644 "$root/NOTICE" "$package/licenses/Codex-NOTICE"
    install -Dm644 "$root/wrangler/crates/codex-wrangler/LICENSE" \
        "$package/licenses/Wrangler-LICENSE"
    "$package/bin/codex" completion zsh >"$package/_codex"
    printf 'codex_version=%s\nwrangler_version=%s\nsource_commit=%s\n' \
        "$codex_version" "$wrangler_version" "$revision" \
        >"$package/distribution"
    mv "$package" "$payload"
fi

for executable in codex codex-code-mode-host codex-wrangler-bridge codex-wrangler; do
    [ -x "$payload/bin/$executable" ] || die "payload lacks $executable"
done
[ -f "$payload/distribution" ] || die 'payload provenance is absent'

previous=
if [ -L "$distribution_root/current" ]; then
    previous=$(readlink "$distribution_root/current")
fi
next="$distribution_root/.current.$$"
ln -s "$identity" "$next"
mv -Tf "$next" "$distribution_root/current"

for executable in codex codex-code-mode-host codex-wrangler-bridge codex-wrangler; do
    next="$install_root/bin/.$executable.$$"
    ln -s "$distribution_root/current/bin/$executable" "$next"
    mv -Tf "$next" "$install_root/bin/$executable"
done
next="$install_root/share/zsh/site-functions/._codex.$$"
ln -s "$distribution_root/current/_codex" "$next"
mv -Tf "$next" "$install_root/share/zsh/site-functions/_codex"

PATH="$install_root/bin:$PATH" "$install_root/bin/codex-wrangler" install

for candidate in "$distribution_root"/*; do
    [ -d "$candidate" ] || continue
    name=${candidate##*/}
    [ "$name" = current ] && continue
    [ "$name" = "$identity" ] && continue
    [ -n "$previous" ] && [ "$name" = "$previous" ] && continue
    [ -f "$candidate/distribution" ] || continue
    rm -rf -- "$candidate"
done

printf 'installed Codex %s and Wrangler %s from %s\n' \
    "$codex_version" "$wrangler_version" "$short_revision"
