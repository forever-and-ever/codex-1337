[Unit]
Description=Staging Codex app server (trial build beside production)

[Service]
Type=simple
ExecStart=:@CODEX@ app-server --listen unix:// --managed-daemon --linux-sandbox-pid-namespace inherit
# Production owns the persisted remote-control enrollment.
Environment=CODEX_INTERNAL_APP_SERVER_REMOTE_CONTROL_DISABLED=1
OOMPolicy=continue
Restart=always
RestartSec=3s
KillMode=mixed
TimeoutStopSec=30s
UMask=0077
Environment=PATH=%h/bin:%h/.cargo/bin:%h/.local/bin:/usr/local/bin:/usr/bin

[Install]
WantedBy=default.target
